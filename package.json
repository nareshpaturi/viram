{
  "name": "viram",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "expo": "~57.0.25",
    "expo-asset": "~57.0.18",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-dev-client": "~57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.11",
    "expo-notifications": "~57.0.21",
    "expo-quick-actions": "^6.0.2",
    "expo-router": "~57.0.23",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "android": "expo run:android",
    "audio:manifest": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-audio-manifest.mjs",
    "audio:tones": "node scripts/render-tones.mjs",
    "audio:voice-placeholders": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-voice-placeholders.mjs",
    "brand:assets": "node scripts/render-brand-assets.mjs",
    "check": "npm run typecheck && npm run check:content && npm run check:theme && npm run check:audio && npm run check:site && npm test -- --ci",
    "check:audio": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-audio-manifest.mjs --check",
    "check:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-content.mjs",
    "check:site": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-site-data.mjs --check",
    "check:theme": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-theme-contrast.mjs",
    "content:preview": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/render-content-preview.mjs",
    "ios": "expo run:ios",
    "site:data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-site-data.mjs",
    "start": "expo start",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "web": "expo start --web"
  },
  "private": true,
  "overrides": {
    "react-dom": "19.2.3",
    "@expo/fingerprint": "0.20.13"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^expo-modules-core(/.*)?$": "<rootDir>/node_modules/expo/node_modules/expo-modules-core$1"
    }
  }
}
