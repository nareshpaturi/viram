<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/viram_widget_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/viram_widget_background"
  android:orientation="vertical"
  android:gravity="center_vertical"
  android:padding="14dp">

  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageView
      android:layout_width="8dp"
      android:layout_height="8dp"
      android:src="@drawable/viram_widget_dot"
      android:importantForAccessibility="no" />
    <TextView
      android:id="@+id/viram_widget_eyebrow"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:text="Breathe"
      android:textColor="#A8CFD0"
      android:textSize="12sp" />
  </LinearLayout>

  <TextView
    android:id="@+id/viram_widget_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="Sama Vritti"
    android:textColor="#EEF4EF"
    android:textSize="17sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/viram_widget_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="4 · 4 · 4 · 4 · 5 min"
    android:textColor="#C9D6D0"
    android:textSize="13sp" />
</LinearLayout>
