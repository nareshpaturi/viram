{
  "expo": {
    "name": "Viram",
    "slug": "viram",
    "version": "1.0.0",
    "scheme": "viram",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "app.viram",
      "appleTeamId": "BPD6N9TLQ4",
      "supportsTablet": false,
      "associatedDomains": ["applinks:viram.app"],
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthUpdateUsageDescription": "Viram adds your completed breathing practices to Apple Health as mindful minutes. It never reads health data."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": [],
        "com.apple.security.application-groups": ["group.app.viram"]
      }
    },
    "android": {
      "package": "app.viram",
      "adaptiveIcon": {
        "backgroundColor": "#12372F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": true,
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.MODIFY_AUDIO_SETTINGS"],
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "viram.app", "pathPrefix": "/r/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "plugins": [
      "./plugins/withLocalNotificationsOnly",
      "./plugins/withWearApp",
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-quick-actions",
      "@bacons/apple-targets",
      ["expo-notifications", { "icon": "./assets/android-icon-monochrome.png", "color": "#12372F" }],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "16.4" },
          "android": { "minSdkVersion": 26, "compileSdkVersion": 36, "targetSdkVersion": 36 }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBFCF8",
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": { "projectId": "8eda3a7e-f9aa-4d46-b6aa-66084a7d786f" }
    },
    "owner": "naresh.paturi"
  }
}
